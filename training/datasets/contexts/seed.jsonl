{"text": "Raat ho gayi, main sone ja raha hoon.", "language": "hinglish", "intent": "SET_CONTEXT", "context_mode": "SLEEPING", "call_handling": true, "action": "SET_CONTEXT", "parameters": {}, "notes": null}
