{"text": "Bahut neend aa rahi hai, so jaana hai ab.", "language": "hi", "intent": "SET_CONTEXT", "context_mode": "SLEEPING", "call_handling": true, "action": "SET_CONTEXT", "parameters": {}, "notes": null}
