APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Host-side ports are remapped to 5433/6380 in docker-compose.yml to avoid
# clashing with other local services; containers still talk to each other
# on the standard 5432/6379 inside the compose network.
DATABASE_URL=postgresql+asyncpg://wow:wow@localhost:5433/wow_ai
REDIS_URL=redis://localhost:6380/0

MEMORY_EMBEDDING_DIM=384

SECRET_KEY=change-me-in-production

# LanguageModelProvider selection: "rule_based" (default, no ML deps) or
# "local_wow" (WOW's own trained model - requires backend/requirements-local-model.txt
# and a trained model at WOW_MODEL_DIR). Never a hosted third-party AI API.
MODEL_PROVIDER=rule_based
WOW_MODEL_DIR=training/models/wow-brain/v0

# AgentRuntime selection: "wow_brain" (default, v0's straight-line flow) or
# "wow_agent" (opt-in - state/memory/policy/tool orchestrator, see
# backend/app/agent/). Both implement the same AgentRuntime contract.
AGENT_RUNTIME=wow_brain
# Minimum overall model confidence required before AGENT_RUNTIME=wow_agent
# authorizes a sensitive action (save memory, change context, transfer the
# call, ...) outright rather than asking the caller to clarify.
POLICY_MIN_SENSITIVE_CONFIDENCE=0.75

# How long a COMPLETED call's history stays in the database before
# `python -m app.learning.run_call_retention_cleanup` removes it. No
# scheduler is wired up in Phase 1 - run this via an external cron/task
# scheduler.
CALL_RETENTION_DAYS=15

# Real self-hosted voice, for a real local test (see docs/PLIVO_TESTING.md):
# "simulated" (default, no heavy ML deps) or the real engine. Never a
# hosted third-party speech API.
# STT_PROVIDER=local_whisper
# TTS_PROVIDER=local_piper
# WHISPER_MODEL_SIZE=base

# Real Plivo telephony bridge (app/api/routes/telephony_plivo.py) - the
# public https/wss URL this backend is reachable at (a Cloudflare Tunnel/
# ngrok URL during local testing). Required for a real Plivo call to reach
# this backend; see docs/PLIVO_TESTING.md.
# PUBLIC_BASE_URL=https://your-tunnel-subdomain.trycloudflare.com

# --- Secrets (placeholders only - NEVER commit real values; set them as real
# environment variables or in a git-ignored backend/.env) ---

# Plivo credentials (Plivo console). The Auth Token verifies the real
# X-Plivo-Signature-V3 header on the Answer URL webhook. The webhook FAILS
# CLOSED (503) without it. The Auth ID is reserved for Plivo REST calls.
# PLIVO_AUTH_ID=
# PLIVO_AUTH_TOKEN=
# Local-only escape hatch (ignored whenever PUBLIC_BASE_URL is set):
# PLIVO_ALLOW_UNSIGNED_WEBHOOKS=true

# Shared secret every REST route (except /health and the Plivo routes)
# requires in the X-WOW-API-Key header. Generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The backend REFUSES TO START with PUBLIC_BASE_URL set and this (or
# PLIVO_AUTH_TOKEN) unset. See docs/SECURITY.md.
# API_ACCESS_KEY=

# Plivo media-bridge caps and the stream-token lifetime (defaults shown).
# PLIVO_STREAM_TOKEN_TTL_SECONDS=120
# PLIVO_MAX_CONCURRENT_STREAMS=2
# PLIVO_MAX_CALL_SECONDS=1800
