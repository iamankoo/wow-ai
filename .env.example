APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Host-side ports are remapped to 5433/6380 in docker-compose.yml to avoid
# clashing with other local services; containers still talk to each other
# on the standard 5432/6379 inside the compose network.
DATABASE_URL=postgresql+asyncpg://wow:wow@localhost:5433/wow_ai
REDIS_URL=redis://localhost:6380/0

MEMORY_EMBEDDING_DIM=384

SECRET_KEY=change-me-in-production

# LanguageModelProvider selection: "rule_based" (default, no ML deps) or
# "local_wow" (WOW's own trained model - requires backend/requirements-local-model.txt
# and a trained model at WOW_MODEL_DIR). Never a hosted third-party AI API.
MODEL_PROVIDER=rule_based
WOW_MODEL_DIR=training/models/wow-brain/v0

# AgentRuntime selection: "wow_brain" (default, v0's straight-line flow) or
# "wow_agent" (opt-in - state/memory/policy/tool orchestrator, see
# backend/app/agent/). Both implement the same AgentRuntime contract.
AGENT_RUNTIME=wow_brain
# Minimum overall model confidence required before AGENT_RUNTIME=wow_agent
# authorizes a sensitive action (save memory, change context, transfer the
# call, ...) outright rather than asking the caller to clarify.
POLICY_MIN_SENSITIVE_CONFIDENCE=0.75

# How long a COMPLETED call's history stays in the database before
# `python -m app.learning.run_call_retention_cleanup` removes it. No
# scheduler is wired up in Phase 1 - run this via an external cron/task
# scheduler.
CALL_RETENTION_DAYS=15
