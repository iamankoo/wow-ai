APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# Host-side ports are remapped to 5433/6380 in docker-compose.yml to avoid
# clashing with other local services; containers still talk to each other
# on the standard 5432/6379 inside the compose network.
DATABASE_URL=postgresql+asyncpg://wow:wow@localhost:5433/wow_ai
REDIS_URL=redis://localhost:6380/0

MEMORY_EMBEDDING_DIM=384

SECRET_KEY=change-me-in-production

# LanguageModelProvider selection: "rule_based" (default, no ML deps) or
# "local_wow" (WOW's own trained model - requires backend/requirements-local-model.txt
# and a trained model at WOW_MODEL_DIR). Never a hosted third-party AI API.
MODEL_PROVIDER=rule_based
WOW_MODEL_DIR=training/models/wow-brain/v0
