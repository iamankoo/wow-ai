<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Phase 2 Block 6: real Android call integration via CallScreeningService
      (not InCallService/default-dialer takeover - CallScreeningService is
      the lighter-weight, non-default-dialer path Android provides for
      exactly WOW's use case: observe/screen incoming calls without
      replacing the system Phone app's UI, matching the option this
      manifest and MainActivity.kt already named as the Phase 2 plan).
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Phase 6 Part D: contacts permission, requested explicitly during
         onboarding (see MainActivity's PERMISSIONS_CHANNEL) - not used yet
         beyond being granted; wiring caller-name lookup against it is
         future work, not invented here. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Phase 6 Part J: real microphone capture for voice command / the
         initial personalization call - real STT input, not a stub. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Phase 6 Part H: the real floating WOW button - a live
         TYPE_APPLICATION_OVERLAY Window (WowFloatingButtonService), not a
         decorative toggle. Granted via the system's "display over other
         apps" settings screen, not a runtime dialog. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Phase 6 Part T: the real GitHub-Release-based update checker -
         downloads a real APK asset and installs it via a real Android
         package-install intent. Granting the underlying per-source
         "install unknown apps" permission still requires a dedicated
         settings screen (Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES),
         same pattern as SYSTEM_ALERT_WINDOW above. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Phase 8: the real "WOW handled a call" notification
         (NotificationHelper.kt) - a runtime-grantable permission on API 33+
         only; posting notifications needs no permission on older APIs. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="WOW AI"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <service
            android:name=".WowCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <service
            android:name=".WowFloatingButtonService"
            android:exported="false" />

        <!-- Phase 6 Part T: exposes the downloaded update APK (written to
             getExternalFilesDir()/updates by the Dart update checker) to
             the system package installer via a content:// URI, since
             Android forbids installing from a plain file:// path/exposing
             app-private storage directly. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
